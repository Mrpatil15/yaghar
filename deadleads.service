[Unit]
Description=Dead-Lead Reactivation Studio Streamlit Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/dead-leads
ExecStart=/usr/local/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
